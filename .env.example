# Local development settings. Copy to .env (`make setup` does this). Never commit .env.
# In the cluster, put the secret values in Secret app-credentials instead (see README).

# Elasticsearch
ES_URL=http://localhost:9200
ES_API_KEY=
ES_INDEX=talks

# OpenAI key, for the Elasticsearch inference endpoint (embeddings)
OPENAI_API_KEY=

# Dash0 via OpenTelemetry (backend traces, metrics, logs).
# Endpoint: Dash0 > Settings > Endpoints > "OTLP over HTTP" (for example https://ingress.us-west-2.aws.dash0.com).
# Token: Dash0 > Settings > Auth tokens, with Ingesting permission.
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to run without telemetry.
OTEL_SERVICE_NAME=affinity-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20YOUR_DASH0_AUTH_TOKEN
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_LOGS_EXPORTER=otlp

# Dash0 website monitoring (RUM). The token is visible in the browser:
# use a separate ingest-only token, limited to one dataset.
# Endpoint example: https://ingress.us-west-2.aws.dash0.com/v1/traces
DASH0_RUM_ENDPOINT=
DASH0_RUM_TOKEN=

# Session signing and attendee hashing (HMAC). Leave empty locally for the dev key.
# In the cluster, put it in Secret app-credentials.
SESSION_SIGNING_KEY=
